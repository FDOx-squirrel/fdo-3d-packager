config.local.json

# --- Note ---
# data/raw/ can hold large local scans or Sketchfab downloads; keep an eye
# on repo size before committing those.

# --- dist/ (PRIMER.md S15) ---
# Everything the pipeline builds: dist/_build/<slug>/ and dist/_build/<slug>.zip
# (intermediates) and dist/<slug>_release/ (build_fdo's finished bundle,
# fdo-metadata.ttl, ro-crate-metadata.json, ...). All of it is rebuildable from
# data/raw/, and a bundle is tens of MB per model -- not repository content.
# Publish the finished bundle through Zenodo, not through git.
dist/
data/*
PATCH-README.md
cache*
dist/ci-smoke*

# --- Local working files, not part of the repository ---
/govan_enrich.py
/pipeline_run.md
/test/
